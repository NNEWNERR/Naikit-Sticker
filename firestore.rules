rules_version = '2';

// =============================================================================
// Naikit-Sticker Firestore security rules — v2 (RBAC)
// -----------------------------------------------------------------------------
// Architecture (see SCHEMA.md — source of truth):
//   * Identity = Firebase Auth uid. request.auth is NON-null for any signed-in
//     staff member. The old plain-text-password / custom-localStorage login is
//     GONE (A1 landed) — there is no public `users` read hole anymore.
//   * Role = custom claim `request.auth.token.role`
//     ('seller' | 'graphic' | 'production' | 'admin' | 'finance').
//     finance = read-all (เหมือน admin) เพื่อตรวจเงิน — ดู docs/FINANCE-CONTROLS.md F3.
//   * ALL writes go through Cloud Functions (Admin SDK), which bypass these
//     rules. Therefore every collection here is `write: if false` for clients —
//     create/update/delete are impossible from the browser. This guarantees
//     atomic (job + job_events) updates and server-verified status transitions.
//   * Reads go directly from the client and are scoped per-role below.
//
// Read model per RBAC matrix:
//   users        — self, or any if admin
//   jobs         — seller: seller_uid==self
//                  graphic: design_uid==self OR status=='รอออกแบบ' (design queue)
//                  production: print_uid==self OR status in
//                              ['คอนเฟิร์มแล้ว','รอผลิต'] (production queue)
//                  admin: all
//   job_events   — any signed-in staff (audit log; queried by job_id only,
//                  ids are non-enumerable; doing a parent-job get() per doc
//                  would blow the rules document-access limit on busy jobs)
//   comments     — same as job_events
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }
    // finance = ผู้ตรวจเงิน (F3): อ่านได้ทั้งหมดเหมือน admin แต่ไม่ใช่ admin
    // (mutations ทั้งหมดผ่าน Cloud Functions อยู่แล้ว — write:false ทุก collection)
    function canReadAll() {
      return isSignedIn() && (role() == 'admin' || role() == 'finance');
    }
    function isStaff() {
      return isSignedIn()
          && role() in ['seller', 'graphic', 'production', 'admin', 'finance'];
    }

    // ---- users -------------------------------------------------------------
    // A user can read their own doc; admin can read anyone. Never client-write —
    // username/password/custom-claim must be set together in admin context via
    // the createUser / setUserRole / setUserActive / resetPassword callables.
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || canReadAll());
      allow write: if false;
    }

    // ---- jobs (work orders) ------------------------------------------------
    // Read is role-scoped. Each home-kanban query (see jobs.service.ts)
    // constrains its where-clauses so every returned doc satisfies the predicate
    // below; single-doc detail reads (watchJob) are checked the same way.
    match /jobs/{jobId} {
      // graphic เห็น: งานที่ตนออกแบบ/รับพิมพ์ + คิวออกแบบ + **คิวพิมพ์ FUJI** (machines มี 'fuji')
      // production เห็น: งานที่ตนรับพิมพ์ + **คิวพิมพ์ที่ไม่ใช่ FUJI** (machines มี vinyl/large_sticker/cut_sticker/other)
      // machines = denormalized จาก work_items.type (ดู lib/machines.ts) — rules วน work_items ไม่ได้
      allow read: if isSignedIn() && (
        canReadAll() ||
        (role() == 'seller'     && resource.data.seller_uid == request.auth.uid) ||
        (role() == 'graphic'    && (resource.data.design_uid == request.auth.uid
                                    || resource.data.print_uid == request.auth.uid
                                    || resource.data.status == 'รอออกแบบ'
                                    || (resource.data.status in ['คอนเฟิร์มแล้ว', 'รอผลิต', 'กำลังผลิต', 'รอส่งมอบ', 'ส่งมอบแล้ว']
                                        && 'machines' in resource.data
                                        && resource.data.machines.hasAny(['fuji'])))) ||
        (role() == 'production'  && (resource.data.print_uid == request.auth.uid
                                    || (resource.data.status in ['คอนเฟิร์มแล้ว', 'รอผลิต', 'กำลังผลิต', 'รอส่งมอบ', 'ส่งมอบแล้ว']
                                        && 'machines' in resource.data
                                        && resource.data.machines.hasAny(['vinyl', 'large_sticker', 'cut_sticker', 'other']))))
      );
      allow write: if false; // all mutations via Cloud Functions
    }

    // ---- job_events (audit log) --------------------------------------------
    match /job_events/{eventId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- comments ----------------------------------------------------------
    match /comments/{commentId} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---- cash_sessions (F5 — กระทบยอดเงินสดรายวัน) -------------------------
    // อ่านได้เฉพาะ finance/admin; เขียนผ่าน Cloud Functions เท่านั้น
    // (reconcileCashSession / closeCashSession). ดู docs/FINANCE-CONTROLS.md F5
    match /cash_sessions/{sessionId} {
      allow read: if canReadAll();
      allow write: if false;
    }

    // ---- payments (F8 — สลิป/การจ่าย) -------------------------------------
    // finance/admin อ่านได้ทั้งหมด; seller อ่านเฉพาะ payment ที่ผูกงานตัวเอง
    // (denormalized seller_uids). เขียนผ่าน Cloud Functions เท่านั้น.
    // ดู docs/F8-SLIP-PAYMENT-DESIGN.md
    match /payments/{paymentId} {
      allow read: if canReadAll()
        || (isSignedIn() && request.auth.uid in resource.data.seller_uids);
      allow write: if false;
    }

    // ---- refunds (F8 — คืนเงิน; seller ขอ → finance อนุมัติ) ---------------
    match /refunds/{refundId} {
      allow read: if canReadAll()
        || (isSignedIn() && request.auth.uid == resource.data.seller_uid);
      allow write: if false;
    }

    // ---- rate_cards (F7 — ราคากลาง) ---------------------------------------
    // อ่านได้เฉพาะ finance/admin (ใช้ในหน้า manage + audit); เขียนผ่าน Cloud Function
    // (upsertRateCard, admin) เท่านั้น. ดู docs/F7-RATE-CARD-DESIGN.md
    match /rate_cards/{rateId} {
      allow read: if canReadAll();
      allow write: if false;
    }

    // ---- price_audits (F7 — variance snapshot) ----------------------------
    // ⚠️ canReadAll เท่านั้น — seller/graphic/production อ่านไม่ได้เด็ดขาด (Q4: covert
    // audit; Firestore ซ่อน field รายตัวไม่ได้ จึงแยก collection). เขียนผ่าน CF เท่านั้น.
    match /price_audits/{jobId} {
      allow read: if canReadAll();
      allow write: if false;
    }

    // ---- material_reconciles (F14 ชั้น B — reconcile วัสดุรายเดือน, advisory) ----
    // อ่าน canReadAll (finance/admin); เขียนผ่าน CF เท่านั้น.
    match /material_reconciles/{period} {
      allow read: if canReadAll();
      allow write: if false;
    }

    // ---- default deny ------------------------------------------------------
    // Legacy v1 collections (groups/sites/schedules/slots/broadcasts/services,
    // job_drafts) are intentionally NOT matched → denied. Delete them from the
    // Firebase console; nothing reads them anymore.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
