rules_version = '2';

// =============================================================================
// Naikit-Sticker Firestore security rules
// -----------------------------------------------------------------------------
// TEMPORARY rules — these are scoped to the current architecture where the app
// uses a custom localStorage session (NO Firebase Auth). Because `request.auth`
// is always null, we CANNOT do per-user authorization in these rules.
//
// !!! CRITICAL — READ BEFORE DEPLOYING !!!
// The `users` collection is currently PUBLICLY READABLE. The client-side login
// flow (`firestore.service.ts: signInWithUsernameAndPassword`) does a raw
// `getDocs(where username==X && password==Y)` query, which requires read
// access. We CANNOT close this hole at the rules layer without first moving
// the login server-side. That is tracked as backlog item A1 (Firebase Auth
// migration). Deploying THIS rules file does NOT close the password-leak
// vector — A2 (these rules) only protects the OTHER collections (jobs,
// comments, sites, groups, etc.) against arbitrary writes and exfiltration.
// Until A1 lands:
//   * passwords stored on user documents are reachable by anyone with the
//     Firestore project ID;
//   * client writes to `users` are blocked here (only Cloud Functions /
//     Admin SDK can create or modify user docs).
// Treat A1 as the gating fix. A2 is harm-reduction, not a remedy.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------
    function isReasonableString(v, max) {
      return v is string && v.size() <= max;
    }
    function isOptionalString(v, max) {
      return !(v is string) || v.size() <= max;
    }

    // ---- users -------------------------------------------------------------
    // TEMPORARY: client-side login (signInWithUsernameAndPassword) needs to
    // query this collection to authenticate; until A1 (Firebase Auth) lands,
    // we MUST allow public read or login dies. The password-leak risk is
    // documented at the top of this file. Writes are blocked — only Cloud
    // Functions / Admin SDK should create or modify user documents.
    match /users/{userId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- jobs (work orders) ------------------------------------------------
    match /jobs/{jobId} {
      allow read: if true;  // currently public-ish; tighten under A1
      allow create: if
        request.resource.data.keys().hasAll(['status', 'created_at']) &&
        isReasonableString(request.resource.data.status, 64) &&
        isOptionalString(request.resource.data.serial_number, 64) &&
        isOptionalString(request.resource.data.customer_name, 200) &&
        isOptionalString(request.resource.data.phone, 32) &&
        isOptionalString(request.resource.data.remark, 2000);
      allow update: if
        isReasonableString(request.resource.data.status, 64) &&
        isOptionalString(request.resource.data.remark, 2000);
      allow delete: if false; // soft-delete via flag, never hard delete
    }

    // ---- comments ----------------------------------------------------------
    match /comments/{commentId} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasAll(['worksheet_id', 'user', 'text']) &&
        isReasonableString(request.resource.data.worksheet_id, 128) &&
        isReasonableString(request.resource.data.user, 64) &&
        isReasonableString(request.resource.data.text, 2000);
      // Allow soft-delete + like updates only. Disallow rewriting user/text.
      allow update: if
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['likes', 'is_deleted', 'deleted_at', 'replies']);
      allow delete: if false;
    }

    // ---- job_drafts --------------------------------------------------------
    match /job_drafts/{draftId} {
      allow read: if true;
      allow create, update: if
        isOptionalString(request.resource.data.status, 64) &&
        isOptionalString(request.resource.data.remark, 2000);
      allow delete: if false;
    }

    // ---- sites / groups (reference data; admin-managed) --------------------
    // Until A1, these are read-only from the client and write-only via console
    // / Cloud Functions.
    match /sites/{siteId} {
      allow read: if true;
      allow write: if false;
    }
    match /groups/{groupId} {
      allow read: if true;
      allow write: if false;
    }

    // ---- default deny ------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
