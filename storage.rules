rules_version = '2';

// =============================================================================
// Naikit-Sticker Cloud Storage rules — v2
// -----------------------------------------------------------------------------
// Firebase Auth has landed (A1), so request.auth is non-null for signed-in
// staff. Uploads are done directly from the client (uploadBytes) by an
// authenticated user, then the resulting download URL is handed to a Cloud
// Function. These rules enforce: signed-in only, 10MB/file cap, image|pdf
// content-type, and the two known path patterns.
//
// Upload paths (must match FE):
//   images/{year}/{month}/{bucket}/{worksheet|reference}/{file}
//     — create-work-sheet.component.ts (bucket = per-submission UUID)
//   jobs/{jobId}/{design|print}/{file}
//     — jobs.service.ts uploadImages() (submitDesign / uploadPrint)
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAllowedContentType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }
    function isUnderSizeCap(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024;
    }

    // Worksheet + reference images (create flow) — photos/screenshots.
    match /images/{year}/{month}/{slug}/{kind}/{filename} {
      allow read: if isSignedIn();
      allow create, update: if
        isSignedIn() &&
        (kind == 'worksheet' || kind == 'reference') &&
        isAllowedContentType() &&
        isUnderSizeCap(20);
      allow delete: if false;
    }

    // Design + print artwork + delivery slips (worksheet-info uploads).
    // Print-ready artwork is high-resolution, so allow a larger cap than photos.
    match /jobs/{jobId}/{kind}/{filename} {
      allow read: if isSignedIn();
      allow create, update: if
        isSignedIn() &&
        (kind == 'design' || kind == 'print' || kind == 'slip') &&
        isAllowedContentType() &&
        isUnderSizeCap(50);
      allow delete: if false;
    }

    // Avatar รูปโปรไฟล์ (self-service) — เขียนได้เฉพาะของตัวเอง, อ่านได้ทุก staff
    // (avatar โชว์บน topbar/cards/comments). resize เป็น 256px ฝั่ง client แล้ว → cap เล็ก.
    match /users/{uid}/avatar/{filename} {
      allow read: if isSignedIn();
      allow create, update: if
        isSignedIn() &&
        request.auth.uid == uid &&
        request.resource.contentType.matches('image/.*') &&
        isUnderSizeCap(2);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Default: deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
