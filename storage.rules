rules_version = '2';

// =============================================================================
// Naikit-Sticker Cloud Storage rules — v2
// -----------------------------------------------------------------------------
// Firebase Auth has landed (A1), so request.auth is non-null for signed-in
// staff. Uploads are done directly from the client (uploadBytes) by an
// authenticated user, then the resulting download URL is handed to a Cloud
// Function. These rules enforce: signed-in only, 10MB/file cap, image|pdf
// content-type, and the two known path patterns.
//
// Upload paths (must match FE):
//   images/{year}/{month}/{bucket}/{worksheet|reference}/{file}
//     — create-work-sheet.component.ts (bucket = per-submission UUID)
//   jobs/{jobId}/{design|print}/{file}
//     — jobs.service.ts uploadImages() (submitDesign / uploadPrint)
// =============================================================================

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAllowedContentType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf';
    }
    function isUnderSizeCap() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB per file
    }

    // Worksheet + reference images (create flow).
    match /images/{year}/{month}/{slug}/{kind}/{filename} {
      allow read: if isSignedIn();
      allow create, update: if
        isSignedIn() &&
        (kind == 'worksheet' || kind == 'reference') &&
        isAllowedContentType() &&
        isUnderSizeCap();
      allow delete: if false;
    }

    // Design + print images (worksheet-info workflow uploads).
    match /jobs/{jobId}/{kind}/{filename} {
      allow read: if isSignedIn();
      allow create, update: if
        isSignedIn() &&
        (kind == 'design' || kind == 'print') &&
        isAllowedContentType() &&
        isUnderSizeCap();
      allow delete: if false;
    }

    // Default: deny everything else.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
